{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared/src/*"],
      "@shared": ["../../packages/shared/src/index.ts"],
      "@persistence/*": ["../../packages/persistence/src/*"],
      "@persistence": ["../../packages/persistence/src/index.ts"],
      "@ingestion/*": ["../../packages/ingestion/src/*"],
      "@ingestion": ["../../packages/ingestion/src/index.ts"],
      "@analytics/*": ["../../packages/analytics/src/*"],
      "@analytics": ["../../packages/analytics/src/index.ts"],
      "@export/*": ["../../packages/export/src/*"],
      "@export": ["../../packages/export/src/index.ts"]
    }
  },
  "include": [
    "src/main/**/*",
    "../../packages/persistence/src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/ingestion/src/**/*.ts",
    "../../packages/analytics/src/**/*.ts",
    "../../packages/export/src/**/*.ts"
  ]
}
